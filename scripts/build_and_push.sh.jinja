#!/bin/bash

# Docker Build & Push Script
# Builds the Docker image and pushes it to Artifact Registry.
# Usage: ./scripts/build_and_push.sh
#
# Environment variables:
#   GCP_PROJECT_ID          — GCP project ID (required)
#   GCP_REGION              — GAR region (default: us-central1)
#   IMAGE_NAME              — Image name (default: {{ package_name }})
#   ARTIFACT_REGISTRY_REPO  — GAR repository name (default: {{ package_name | replace("_", "-") }})
#   PLATFORM                — Build platform (default: linux/amd64 for GCP deployment)

set -euo pipefail

PLATFORM="${PLATFORM:-linux/amd64}"

# Configuration — override via environment variables or edit here
PROJECT_ID="${GCP_PROJECT_ID:-your-gcp-project-id}"
REGION="${GCP_REGION:-us-central1}"
IMAGE_NAME="${IMAGE_NAME:-{{ package_name }}}"
ARTIFACT_REGISTRY_REPO="${ARTIFACT_REGISTRY_REPO:-{{ package_name | replace("_", "-") }}}"
IMAGE_TAG="${REGION}-docker.pkg.dev/${PROJECT_ID}/${ARTIFACT_REGISTRY_REPO}/${IMAGE_NAME}:latest"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_info()  { echo -e "${GREEN}[INFO]${NC}  $1"; }
print_warn()  { echo -e "${YELLOW}[WARN]${NC}  $1"; }
print_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Check dependencies
if ! command -v gcloud &>/dev/null; then
    print_error "gcloud CLI is not installed. See https://cloud.google.com/sdk/docs/install"
    exit 1
fi

if ! command -v docker &>/dev/null; then
    print_error "Docker is not installed. See https://docs.docker.com/get-docker/"
    exit 1
fi

# Check GCP authentication
print_info "Checking GCP authentication..."
if ! gcloud auth list --filter=status:ACTIVE --format="value(account)" | grep -q .; then
    print_warn "Not authenticated with GCP. Running gcloud auth login..."
    gcloud auth login
fi

print_info "Project  : ${PROJECT_ID}"
print_info "Region   : ${REGION}"
print_info "Image    : ${IMAGE_TAG}"
print_info "Platform : ${PLATFORM}"

gcloud config set project "${PROJECT_ID}" --quiet

# Enable required API
print_info "Enabling Artifact Registry API..."
gcloud services enable artifactregistry.googleapis.com --project="${PROJECT_ID}"

# Create Artifact Registry repository if it doesn't exist
print_info "Checking Artifact Registry repository..."
if ! gcloud artifacts repositories describe "${ARTIFACT_REGISTRY_REPO}" \
    --location="${REGION}" \
    --project="${PROJECT_ID}" &>/dev/null; then
    print_info "Creating Artifact Registry repository: ${ARTIFACT_REGISTRY_REPO}"
    gcloud artifacts repositories create "${ARTIFACT_REGISTRY_REPO}" \
        --repository-format=docker \
        --location="${REGION}" \
        --project="${PROJECT_ID}"
else
    print_info "Artifact Registry repository already exists"
fi

# Configure Docker to authenticate with GAR
print_info "Configuring Docker authentication..."
gcloud auth configure-docker "${REGION}-docker.pkg.dev" --quiet

# Build the Docker image
print_info "Building Docker image (platform: ${PLATFORM})..."
GAR_TOKEN=$(gcloud auth print-access-token) docker build \
    --secret id=gar_token,env=GAR_TOKEN \
    --platform "${PLATFORM}" \
    --file infrastructure/Dockerfile \
    --tag "${IMAGE_TAG}" \
    .

# Push the Docker image
print_info "Pushing image to Artifact Registry..."
docker push "${IMAGE_TAG}"

print_info "Build and push complete!"
print_info "Image available at: ${IMAGE_TAG}"
