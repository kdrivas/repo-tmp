#!/bin/bash

# Cloud Run Jobs Execution Script
# Assumes the job already exists (deployed via deploy_cloud_run.sh).
# Usage: ./scripts/run_pipeline_cloud_run.sh [pipeline_yaml]
# Example: ./scripts/run_pipeline_cloud_run.sh pipelines/complete_pipeline.yaml

set -euo pipefail

PIPELINE_YAML="${1:-pipelines/complete_pipeline.yaml}"

# Configuration — must match the values used in deploy_cloud_run.sh
PROJECT_ID="${GCP_PROJECT_ID:-your-gcp-project-id}"
REGION="${GCP_REGION:-us-central1}"
JOB_NAME="${JOB_NAME:-{{ package_name }}-pipeline}"
IMAGE_NAME="${IMAGE_NAME:-{{ package_name }}}"
ARTIFACT_REGISTRY_REPO="${ARTIFACT_REGISTRY_REPO:-{{ package_name }}}"
IMAGE_TAG="${REGION}-docker.pkg.dev/${PROJECT_ID}/${ARTIFACT_REGISTRY_REPO}/${IMAGE_NAME}:latest"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_info()  { echo -e "${GREEN}[INFO]${NC}  $1"; }
print_warn()  { echo -e "${YELLOW}[WARN]${NC}  $1"; }
print_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Check dependencies
if ! command -v gcloud &>/dev/null; then
    print_error "gcloud CLI is not installed. See https://cloud.google.com/sdk/docs/install"
    exit 1
fi

print_info "Project  : ${PROJECT_ID}"
print_info "Region   : ${REGION}"
print_info "Job      : ${JOB_NAME}"
print_info "Image    : ${IMAGE_TAG}"
print_info "Pipeline : ${PIPELINE_YAML}"

gcloud config set project "${PROJECT_ID}" --quiet

# Update the job with the image and command to run the pipeline in local mode
print_info "Updating Cloud Run Job..."
gcloud run jobs update "${JOB_NAME}" \
    --image "${IMAGE_TAG}" \
    --command="uv" \
    --args="run,mlops_lib,run_pipeline,${PIPELINE_YAML},--mode,local" \
    --region "${REGION}" \
    --project "${PROJECT_ID}" \
    --quiet

# Execute the job and capture the execution name
print_info "Executing Cloud Run Job..."
EXECUTION_NAME=$(gcloud run jobs execute "${JOB_NAME}" \
    --region "${REGION}" \
    --project "${PROJECT_ID}" \
    --format "value(metadata.name)")

print_info "Job execution started!"
print_info "Execution : ${EXECUTION_NAME}"
print_info ""
print_info "Check status:"
print_info "  gcloud run jobs executions describe ${EXECUTION_NAME} --region ${REGION} --project ${PROJECT_ID}"
print_info ""
print_info "Stream logs:"
print_info "  gcloud logging read \"resource.type=cloud_run_job AND resource.labels.job_name=${JOB_NAME} AND resource.labels.location=${REGION}\" --limit 100 --project ${PROJECT_ID} --format json"
