{
  //
  // Set correct python path to venv's one
  //
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  //
  // Hide .venv from explorer and searchbar
  //
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.ruff_cache/**": true
  },
  "files.exclude": {
    "**/.ruff_cache/": true
  },
  "search.exclude": {
    "**/.venv/": true,
    "**/.ruff_cache/": true
  },
  //
  // Linting and formatting
  //
  // Configured following https://github.com/astral-sh/ruff-vscode?tab=readme-ov-file#configuring-vs-code
  // guidelines.
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  //
  // JSON formatting and validation
  //
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonl]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "editor.rulers": [
    100 // if changing line length, also do it in pyproject.toml's [tool.ruff] section
  ],
  "editor.wordWrapColumn": 100,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  //
  // Jupyter
  //
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "notebook.formatOnSave.enabled": true,
  "python.testing.pytestArgs": [
    "tests",
    "--cov=src" // Ensure VS Code test coverage only considers our package and not the .venv or notebooks.
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  // mkdocs and material theme support. See https://squidfunk.github.io/mkdocs-material/creating-your-site/#minimal-configuration.
  "yaml.schemas": {
    "https://json.schemastore.org/mkdocs-1.6.json": "mkdocs.yml",
    "https://squidfunk.github.io/mkdocs-material/schema.json": "mkdocs.yml"
  },
  "yaml.customTags": [
    "!ENV scalar",
    "!ENV sequence",
    "!relative scalar",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.to_svg",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.twemoji",
    "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format"
  ]
}