"""Entry point to run the pipeline locally.

Usage:
    python -m {{ package_name }}.pipelines.run
"""

import logging

from mlops_lib.pipelines.flyte import FlyteRunner

from {{ package_name }}.pipelines.complete_pipeline import complete_pipeline

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
)

logger = logging.getLogger(__name__)

runner = FlyteRunner(mode="local")


def run_complete() -> None:
    """Run the complete pipeline (all steps) locally."""
    logger.info("Running complete pipeline...")
    result = runner.run(complete_pipeline, version="v0.1")
    logger.info("Complete result: %s", result)


def main() -> None:
    """Run the pipeline."""
    run_complete()


if __name__ == "__main__":
    main()
